# Cabeceras de Cloudflare Pages
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # style-src necesita 'unsafe-inline' porque el CSS va incrustado en el <head>
  # (una sola petición = mejor LCP). Los scripts sí van en modo estricto.
  # Si sirves el preview de audio desde un dominio propio, añádelo a media-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; media-src 'self' https: blob:; frame-src https://open.spotify.com https://www.youtube-nocookie.com; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'

# Los recursos con hash o versionados se cachean para siempre
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# El HTML siempre se revalida para que los cambios salgan al instante
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
